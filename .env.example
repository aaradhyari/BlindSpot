# ─── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Firebase Admin SDK ──────────────────────────────────────
# Option A: Service-account JSON file path (recommended for local dev)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Option B: Inline credentials (for cloud / CI environments)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Firebase Web SDK (public values, safe in client code) ───
FIREBASE_WEB_API_KEY=AIzaSy...
FIREBASE_WEB_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_WEB_PROJECT_ID=your-project-id
FIREBASE_WEB_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_WEB_MESSAGING_SENDER_ID=000000000000
FIREBASE_WEB_APP_ID=1:000000000000:web:xxxxxxxxxxxxxx

# ─── Session ─────────────────────────────────────────────────
SESSION_SECRET=replace-with-a-strong-random-secret-at-least-64-chars

# ─── CSRF ────────────────────────────────────────────────────
CSRF_SECRET=replace-with-another-strong-random-secret

# ─── CORS ────────────────────────────────────────────────────
ALLOWED_ORIGIN=http://localhost:3000

# ─── Bootstrap (one-time admin setup) ────────────────────────
# Set this ONLY when running `npm run bootstrap`, then remove it.
# BOOTSTRAP_ADMIN_UID=firebase-auth-uid-of-first-admin
